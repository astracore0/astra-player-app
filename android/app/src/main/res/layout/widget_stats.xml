<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/s_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WATCH TIME TODAY" android:textColor="#60A5FA" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.1" />
            <TextView android:id="@+id/s_today" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0s" android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/s_streak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 day streak" android:textColor="#FBBF24" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
    <ImageView android:id="@+id/s_chart" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:scaleType="fitCenter" android:contentDescription="Last 7 days" />
    <TextView android:id="@+id/s_week" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="This week" android:textColor="#9AA6C0" android:textSize="11sp" android:maxLines="1" />
</LinearLayout>
